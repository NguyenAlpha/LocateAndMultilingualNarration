<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dto="clr-namespace:Shared.DTOs.Tours;assembly=Shared"
             x:Class="Mobile.Pages.TourListPage"
             Title="Tour tham quan"
             BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="Auto,*">

        <Grid Grid.Row="0" Padding="20,20,20,16" ColumnDefinitions="*,Auto">
            <VerticalStackLayout Grid.Column="0" Spacing="4">
                <Label Text="Tour tham quan"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="#1E2937"/>
                <Label Text="Chọn một tour để được dẫn đường theo lộ trình"
                       FontSize="13.5"
                       TextColor="#64748B"/>
            </VerticalStackLayout>

            <Button Grid.Column="1"
                    Text="↻"
                    FontSize="18"
                    BackgroundColor="White"
                    TextColor="#4F46E5"
                    CornerRadius="12"
                    WidthRequest="44"
                    HeightRequest="44"
                    Padding="0"
                    Command="{Binding LoadCommand}"/>
        </Grid>

        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsLoading}"
                     Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Tours}"
                            SelectionMode="None"
                            Margin="16,0,16,16">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24" Spacing="12" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="🗺"
                               FontSize="48"
                               HorizontalOptions="Center"/>
                        <Label Text="{Binding ErrorMessage}"
                               TextColor="#94A3B8"
                               FontSize="14"
                               HorizontalTextAlignment="Center"
                               IsVisible="{Binding HasError}"/>
                        <Label Text="Chưa có tour nào"
                               TextColor="#94A3B8"
                               FontSize="14"
                               HorizontalTextAlignment="Center"
                               IsVisible="{Binding HasNoTours}"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:TourListItemDto">
                        <Frame CornerRadius="18"
                               Padding="16"
                               Margin="0,8"
                               BackgroundColor="White"
                               BorderColor="Transparent"
                               HasShadow="True">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectTourCommand}"
                                    CommandParameter="{Binding .}"/>
                            </Frame.GestureRecognizers>

                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding Name}"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       TextColor="#1F2937"/>
                                <Label Text="{Binding Description}"
                                       FontSize="13.5"
                                       TextColor="#64748B"
                                       MaxLines="2"
                                       LineBreakMode="TailTruncation"/>

                                <HorizontalStackLayout Spacing="10">
                                    <Frame Padding="8,4"
                                           CornerRadius="12"
                                           BackgroundColor="#EEF2FF"
                                           HasShadow="False"
                                           BorderColor="#C7D2FE">
                                        <HorizontalStackLayout Spacing="4">
                                            <Label Text="📍" FontSize="12"/>
                                            <Label Text="{Binding StopCount, StringFormat='{0} điểm'}"
                                                   FontSize="12.5"
                                                   FontAttributes="Bold"
                                                   TextColor="#4338CA"/>
                                        </HorizontalStackLayout>
                                    </Frame>

                                    <Frame Padding="8,4"
                                           CornerRadius="12"
                                           BackgroundColor="#FFF7ED"
                                           HasShadow="False"
                                           BorderColor="#FED7AA">
                                        <HorizontalStackLayout Spacing="4">
                                            <Label Text="⏱" FontSize="12"/>
                                            <Label Text="{Binding EstimatedMinutes, StringFormat='{0} phút', TargetNullValue='—'}"
                                                   FontSize="12.5"
                                                   FontAttributes="Bold"
                                                   TextColor="#9A3412"/>
                                        </HorizontalStackLayout>
                                    </Frame>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
