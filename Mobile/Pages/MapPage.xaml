<?xml version="1.0" encoding="utf-8" ?>
<!--
    MapPage: Trang bản đồ chính của ứng dụng.
    Hiển thị bản đồ OSM (OpenStreetMap) để người dùng xem vị trí các gian hàng,
    danh sách gian hàng để chọn, và bộ điều khiển phát audio thuyết minh.

    xmlns:mapsui : import namespace của thư viện Mapsui — thư viện bản đồ mã nguồn mở
                   dùng OpenStreetMap, không cần API key như Google Maps
    NavigationPage.HasNavigationBar="False" : ẩn thanh navigation bar mặc định,
                   vì trang này tự có header riêng ở Row 0
-->
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
    x:Class="Mobile.Pages.MapPage"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False"
    Title="Bản đồ">

    <!--
        Layout tổng thể: Grid dọc chia 4 hàng
          Row 0 (Auto) : Header — tiêu đề + nút Làm mới
          Row 1 (*)    : Nội dung chính — bản đồ + danh sách gian hàng
          Row 2 (Auto) : Điều khiển audio — Phát / Tạm dừng / Dừng
          Row 3 (Auto) : Trạng thái — loading indicator + thông báo lỗi
    -->
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

        <!-- ===== ROW 0: HEADER ===== -->
        <!-- Thanh tiêu đề tùy chỉnh với nền xanh đậm, gồm tiêu đề bên trái và nút Làm mới bên phải -->
        <Grid Grid.Row="0" Padding="8" BackgroundColor="#FAFAFA" ColumnDefinitions="Auto,*,Auto">

            <!-- Nút quay lại MainPage -->
            <Button Grid.Column="0"
                    Text="←"
                    FontSize="24"
                    BackgroundColor="#FAFAFA"
                    TextColor="Black"
                    CornerRadius="12"
                    HeightRequest="44"
                    WidthRequest="44"
                    Padding="0"
                    Clicked="OnBackClicked" />

            <!-- Tiêu đề trang -->
            <Label Grid.Column="1"
                   Text="Bản đồ gian hàng"
                   TextColor="black"
                   FontAttributes="Bold"
                   FontSize="18"
                   VerticalOptions="Center" />

            <!-- Nút gọi RefreshCommand trong ViewModel để tải lại dữ liệu gian hàng và vẽ lại bản đồ -->
            <Button Grid.Column="2"
                    Text="↺"
                    FontSize="32"
                    Command="{Binding RefreshCommand}"
                    BackgroundColor="#FAFAFA"
                    TextColor="Black"
                    CornerRadius="12"
                    HeightRequest="44"
                    WidthRequest="44"
                    Padding="0" />
        </Grid>

        <!-- ===== ROW 1: TOUR BANNER (chỉ hiển thị khi đang chạy tour) ===== -->
        <Grid Grid.Row="1"
              BackgroundColor="#4F46E5"
              Padding="16,10"
              IsVisible="{Binding IsTourMode}"
              ColumnDefinitions="*,Auto">
            <VerticalStackLayout Grid.Column="0" Spacing="2">
                <Label Text="{Binding TourName, StringFormat='Tour: {0}'}"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="White"/>
                <Label Text="{Binding NextStopName, StringFormat='Điểm kế tiếp: {0}'}"
                       FontSize="12"
                       TextColor="#E0E7FF"/>
            </VerticalStackLayout>
            <Label Grid.Column="1"
                   Text="{Binding TourProgressText}"
                   FontSize="11"
                   FontAttributes="Bold"
                   TextColor="#C4D0FF"
                   VerticalOptions="Center"/>
        </Grid>

        <!-- ===== ROW 2: BẢN ĐỒ + DANH SÁCH GIAN HÀNG ===== -->
        <!--
            Grid dọc chia 2 phần:
              Row 0 (2*) : Bản đồ chiếm 2/3 chiều cao
              Row 1 (*)  : Danh sách gian hàng chiếm 1/3 chiều cao
        -->
        <Grid Grid.Row="2" RowDefinitions="2*,*">

            <!--
                MapView: Control bản đồ của thư viện Mapsui
                x:Name="mapView" cho phép code-behind truy cập trực tiếp để:
                  - Khởi tạo bản đồ (gán Map object)
                  - Thêm/xóa pin marker cho gian hàng
                  - Di chuyển camera đến vị trí cụ thể
            -->
            <mapsui:MapView x:Name="mapView"
                            Grid.Row="0"
                            IsMyLocationButtonVisible="False"
                            IsNorthingButtonVisible="False"/>

            <!--
                Danh sách gian hàng dạng cuộn ngang/dọc
                ItemsSource   : bind đến List<Stall> Stalls trong ViewModel
                SelectionMode : cho phép chọn 1 item tại một thời điểm
                SelectedItem  : bind 2 chiều đến SelectedStall trong ViewModel —
                                khi người dùng tap vào gian hàng, ViewModel nhận được
                                đối tượng đó và có thể di chuyển bản đồ đến vị trí tương ứng
            -->
            <CollectionView Grid.Row="1"
                            ItemsSource="{Binding Stalls}"
                            SelectionMode="Single"
                            SelectedItem="{Binding SelectedStall}"
                            ItemsLayout="HorizontalList">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="8,10"
                                Padding="0"
                                WidthRequest="200"
                                StrokeShape="RoundRectangle 16">
                            <Border.Shadow>
                                <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.07"/>
                            </Border.Shadow>

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroupList>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="White"/>
                                                <Setter Property="Stroke" Value="#E5E7EB"/>
                                                <Setter Property="StrokeThickness" Value="1"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="#EEF2FF"/>
                                                <Setter Property="Stroke" Value="#4F46E5"/>
                                                <Setter Property="StrokeThickness" Value="2"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateGroupList>
                            </VisualStateManager.VisualStateGroups>

                            <Grid RowDefinitions="Auto,Auto" RowSpacing="0">

                                <!-- Icon header -->
                                <Grid Grid.Row="0"
                                      HeightRequest="56"
                                      BackgroundColor="#EEF2FF">
                                    <Label Text="🏪"
                                           FontSize="28"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Grid>

                                <!-- Tên gian hàng -->
                                <VerticalStackLayout Grid.Row="1" Padding="12,10,12,12" Spacing="4">
                                    <Label Text="{Binding StallName}"
                                           FontAttributes="Bold"
                                           FontSize="14"
                                           TextColor="#111827"
                                           MaxLines="2"
                                           LineBreakMode="TailTruncation"/>
                                </VerticalStackLayout>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- ===== ROW 3: ĐIỀU KHIỂN AUDIO ===== -->
        <!--
            3 nút điều khiển phát audio thuyết minh của gian hàng đang chọn
            Mỗi nút bind đến ICommand tương ứng trong ViewModel
        -->
        <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="10" Padding="8"
              IsVisible="{Binding HasSelectedStall}">

            <!-- Phát audio — gọi PlayAudioCommand, phát file audio thuyết minh -->
            <Button Grid.Column="0"
                    Text="▶ Phát"
                    Command="{Binding PlayAudioCommand}"
                    BackgroundColor="#2563EB"
                    TextColor="White"
                    CornerRadius="12" />

            <!-- Tạm dừng — gọi PauseAudioCommand, giữ nguyên vị trí phát -->
            <!-- <Button Grid.Column="1"
                    Text="⏸ Tạm dừng"
                    Command="{Binding PauseAudioCommand}"
                    BackgroundColor="#64748B"
                    TextColor="White"
                    CornerRadius="12" /> -->

            <!-- Dừng hẳn — gọi StopAudioCommand, reset về đầu file audio -->
            <Button Grid.Column="1"
                    Text="⏹ Dừng"
                    Command="{Binding StopAudioCommand}"
                    BackgroundColor="#DC2626"
                    TextColor="White"
                    CornerRadius="12" />
        </Grid>

        <!-- ===== ROW 4: TRẠNG THÁI ===== -->
        <!--
            Hiển thị loading indicator hoặc thông báo lỗi
            Cả hai cùng nằm trong một Grid (chồng lên nhau),
            nhưng ActivityIndicator chỉ hiện khi IsBusy = true,
            còn Label lỗi chỉ hiện khi ErrorMessage có nội dung
        -->
        <Grid Grid.Row="4" Padding="0,0,0,10">

            <!-- Vòng tròn loading — hiển thị và quay khi ViewModel đang tải dữ liệu -->
            <ActivityIndicator IsVisible="{Binding IsBusy}"
                               IsRunning="{Binding IsBusy}"
                               HorizontalOptions="Center" />

            <!-- Thông báo lỗi — hiển thị khi gọi API thất bại hoặc không có dữ liệu -->
            <Label Text="{Binding ErrorMessage}"
                   IsVisible="{Binding HasError}"
                   HorizontalOptions="Center"
                   VerticalOptions="End"
                   TextColor="Red"
                   FontSize="12" />
        </Grid>

    </Grid>

</ContentPage>