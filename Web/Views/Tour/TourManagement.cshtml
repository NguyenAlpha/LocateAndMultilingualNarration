@model Web.Models.TourManagementViewModel
@{
    ViewData["Title"] = "Quản lý Tour";
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <div class="page-pretitle">Admin</div>
                <h2 class="page-title">Quản lý Tour</h2>
            </div>
            <div class="col-auto ms-auto">
                <a class="btn btn-primary" asp-action="Designer">
                    <i class="ti ti-plus me-1"></i>Tạo Tour mới
                </a>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">

        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success alert-dismissible mb-3" role="alert">
                <i class="ti ti-check me-1"></i>@Model.SuccessMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible mb-3" role="alert">
                <i class="ti ti-alert-circle me-1"></i>@Model.ErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="card">
            <div class="card-header">
                <div class="card-title">Danh sách tour (@Model.TotalCount)</div>
                <div class="card-actions">
                    <form method="get" class="d-flex gap-2">
                        <input type="text" name="search" class="form-control form-control-sm" value="@Model.Search" placeholder="Tìm tour..." />
                        <button type="submit" class="btn btn-sm btn-outline-primary">
                            <i class="ti ti-search"></i>
                        </button>
                    </form>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead>
                        <tr>
                            <th>Tên tour</th>
                            <th>Mô tả</th>
                            <th class="text-center">Số điểm</th>
                            <th class="text-center">Thời gian</th>
                            <th class="text-center">Trạng thái</th>
                            <th>Ngày tạo</th>
                            <th class="w-1"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Items.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">Chưa có tour nào. Bấm "Tạo Tour mới" để bắt đầu.</td>
                            </tr>
                        }
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="fw-bold">@item.Name</td>
                                <td class="text-muted text-truncate" style="max-width: 320px;">@item.Description</td>
                                <td class="text-center">@item.StopCount</td>
                                <td class="text-center">
                                    @if (item.EstimatedMinutes.HasValue)
                                    {
                                        <span>@item.EstimatedMinutes phút</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success-lt">Đang hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-lt">Đã tắt</span>
                                    }
                                </td>
                                <td class="text-muted">@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <div class="btn-list flex-nowrap">
                                        <a class="btn btn-sm btn-outline-primary" asp-action="Designer" asp-route-id="@item.Id">
                                            <i class="ti ti-edit"></i>
                                        </a>
                                        <form method="post" asp-action="ToggleActive" asp-route-id="@item.Id" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-secondary" title="Bật/tắt">
                                                <i class="ti ti-toggle-left"></i>
                                            </button>
                                        </form>
                                        <form method="post" asp-action="Delete" asp-route-id="@item.Id" class="d-inline"
                                              onsubmit="return confirm('Xóa tour này?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa">
                                                <i class="ti ti-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <div class="card-footer d-flex align-items-center justify-content-between">
                    <p class="m-0 text-muted">Trang <span>@Model.Page</span> / <span>@Model.TotalPages</span></p>
                    <ul class="pagination m-0 ms-auto">
                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.Page ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-pageSize="@Model.PageSize" asp-route-search="@Model.Search">@p</a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
</div>
