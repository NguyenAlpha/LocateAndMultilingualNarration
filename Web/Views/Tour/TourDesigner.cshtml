@model Web.Models.TourDesignerViewModel
@{
    ViewData["Title"] = Model.IsEdit ? "Sửa Tour" : "Tạo Tour";
    var initialStopsJson = "[]";
    if (Model.Tour != null)
    {
        initialStopsJson = System.Text.Json.JsonSerializer.Serialize(Model.Tour.Stops.Select(s => new
        {
            stallId = s.StallId,
            stallName = s.StallName,
            order = s.Order,
            note = s.Note,
            latitude = s.Latitude,
            longitude = s.Longitude
        }));
    }
    var availableStallsJson = System.Text.Json.JsonSerializer.Serialize(Model.AvailableStalls.Select(s => new
    {
        stallId = s.StallId,
        name = s.Name,
        latitude = s.Latitude,
        longitude = s.Longitude
    }));
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <style>
        #tourMap { height: 640px; border-radius: 8px; }
        .stop-item { cursor: grab; }
        .stop-item.sortable-ghost { opacity: 0.4; }
        .stall-marker-label {
            background: white;
            border: 1px solid #ccc;
            border-radius: 4px;
            padding: 2px 6px;
            font-size: 11px;
            white-space: nowrap;
        }
    </style>
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <div class="page-pretitle">Admin / Tour</div>
                <h2 class="page-title">@(Model.IsEdit ? "Sửa Tour" : "Tạo Tour mới")</h2>
            </div>
            <div class="col-auto ms-auto">
                <a class="btn btn-outline-secondary" asp-action="Index">
                    <i class="ti ti-arrow-left me-1"></i>Quay lại
                </a>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger mb-3">@Model.ErrorMessage</div>
        }

        <div class="row g-3">
            <div class="col-lg-8">
                <div class="card">
                    <div class="card-header">
                        <div class="card-title">Bản đồ — click marker xám để thêm stop, click marker xanh để bỏ khỏi tour</div>
                    </div>
                    <div class="card-body p-0">
                        <div id="tourMap"></div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card mb-3">
                    <div class="card-header">
                        <div class="card-title">Thông tin tour</div>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label required">Tên tour</label>
                            <input id="tourName" type="text" class="form-control" maxlength="128" value="@(Model.Tour?.Name ?? "")" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Mô tả</label>
                            <textarea id="tourDescription" class="form-control" rows="3" maxlength="1024">@(Model.Tour?.Description ?? "")</textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Thời gian ước tính (phút)</label>
                            <input id="tourEstimated" type="number" class="form-control" min="1" max="1440" value="@(Model.Tour?.EstimatedMinutes?.ToString() ?? "")" />
                        </div>
                        <div class="form-check form-switch">
                            <input id="tourIsActive" class="form-check-input" type="checkbox" @(Model.Tour == null || Model.Tour.IsActive ? "checked" : "") />
                            <label class="form-check-label" for="tourIsActive">Đang hoạt động</label>
                        </div>
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header">
                        <div class="card-title">Danh sách điểm dừng (<span id="stopCount">0</span>)</div>
                        <div class="card-actions text-muted small">Kéo để sắp xếp</div>
                    </div>
                    <ul id="stopList" class="list-group list-group-flush">
                        <li class="list-group-item text-muted text-center py-4" id="stopEmpty">Chưa có điểm nào. Click marker trên bản đồ để thêm.</li>
                    </ul>
                </div>

                <div class="d-flex gap-2">
                    <button id="saveBtn" type="button" class="btn btn-primary flex-fill">
                        <i class="ti ti-device-floppy me-1"></i>Lưu tour
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
    <form id="afForm" method="post" style="display:none">@Html.AntiForgeryToken()</form>
    <script>
        const TOUR_ID = @(Model.Tour == null ? "null" : "'" + Model.Tour.Id + "'");
        const availableStalls = @Html.Raw(availableStallsJson);
        const initialStops = @Html.Raw(initialStopsJson);
        const token = document.querySelector('#afForm input[name="__RequestVerificationToken"]').value;

        const stopsState = initialStops.map(s => ({
            stallId: s.stallId,
            stallName: s.stallName,
            latitude: s.latitude,
            longitude: s.longitude,
            note: s.note || null
        }));

        // ---- Leaflet map ----
        let center = [10.7769, 106.7009]; // HCMC default
        if (availableStalls.length > 0) {
            center = [availableStalls[0].latitude, availableStalls[0].longitude];
        }
        const map = L.map('tourMap').setView(center, 15);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap'
        }).addTo(map);

        const markers = {}; // stallId -> marker
        let polyline = null;

        function makeIcon(color) {
            return L.divIcon({
                className: 'stall-marker-label',
                html: `<span style="color:${color};font-weight:bold;">&#9679;</span>`,
                iconSize: [20, 20]
            });
        }

        function stopIndex(stallId) {
            return stopsState.findIndex(s => s.stallId === stallId);
        }

        function refreshMarkerColors() {
            availableStalls.forEach(s => {
                const marker = markers[s.stallId];
                if (!marker) return;
                const idx = stopIndex(s.stallId);
                if (idx >= 0) {
                    marker.setIcon(L.divIcon({
                        className: 'stall-marker-label',
                        html: `<div style="background:#206bc4;color:#fff;border-radius:50%;width:26px;height:26px;display:flex;align-items:center;justify-content:center;font-weight:bold;">${idx + 1}</div>`,
                        iconSize: [26, 26]
                    }));
                } else {
                    marker.setIcon(L.divIcon({
                        className: 'stall-marker-label',
                        html: `<div style="background:#adb5bd;color:#fff;border-radius:50%;width:22px;height:22px;display:flex;align-items:center;justify-content:center;font-size:11px;">&#9679;</div>`,
                        iconSize: [22, 22]
                    }));
                }
            });
        }

        function refreshPolyline() {
            if (polyline) { map.removeLayer(polyline); polyline = null; }
            if (stopsState.length < 2) return;
            const coords = stopsState.map(s => [s.latitude, s.longitude]);
            polyline = L.polyline(coords, { color: '#206bc4', weight: 4, opacity: 0.8 }).addTo(map);
        }

        function renderStopList() {
            const ul = document.getElementById('stopList');
            const emptyEl = document.getElementById('stopEmpty');
            ul.querySelectorAll('li.stop-item').forEach(el => el.remove());

            if (stopsState.length === 0) {
                emptyEl.style.display = '';
                document.getElementById('stopCount').textContent = 0;
                return;
            }
            emptyEl.style.display = 'none';
            document.getElementById('stopCount').textContent = stopsState.length;

            stopsState.forEach((s, i) => {
                const li = document.createElement('li');
                li.className = 'list-group-item stop-item d-flex align-items-center';
                li.dataset.stallId = s.stallId;
                li.innerHTML = `
                    <span class="badge bg-primary me-2" style="width:26px;">${i + 1}</span>
                    <div class="flex-fill">
                        <div class="fw-bold">${escapeHtml(s.stallName)}</div>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-danger ms-2" data-remove="${s.stallId}">
                        <i class="ti ti-x"></i>
                    </button>
                `;
                ul.appendChild(li);
            });

            ul.querySelectorAll('[data-remove]').forEach(btn => {
                btn.addEventListener('click', e => {
                    e.stopPropagation();
                    const sid = btn.getAttribute('data-remove');
                    const idx = stopIndex(sid);
                    if (idx >= 0) {
                        stopsState.splice(idx, 1);
                        renderAll();
                    }
                });
            });
        }

        function escapeHtml(s) {
            return String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]);
        }

        function renderAll() {
            refreshMarkerColors();
            refreshPolyline();
            renderStopList();
        }

        // ---- Init markers ----
        availableStalls.forEach(s => {
            const m = L.marker([s.latitude, s.longitude]).addTo(map);
            m.bindTooltip(s.name, { permanent: false });
            m.on('click', () => {
                const idx = stopIndex(s.stallId);
                if (idx >= 0) {
                    stopsState.splice(idx, 1);
                } else {
                    stopsState.push({
                        stallId: s.stallId,
                        stallName: s.name,
                        latitude: s.latitude,
                        longitude: s.longitude,
                        note: null
                    });
                }
                renderAll();
            });
            markers[s.stallId] = m;
        });

        // ---- SortableJS ----
        const stopList = document.getElementById('stopList');
        new Sortable(stopList, {
            animation: 150,
            filter: '#stopEmpty',
            onEnd: () => {
                const newOrder = [];
                stopList.querySelectorAll('li.stop-item').forEach(el => {
                    const sid = el.dataset.stallId;
                    const s = stopsState.find(x => x.stallId === sid);
                    if (s) newOrder.push(s);
                });
                stopsState.length = 0;
                stopsState.push(...newOrder);
                renderAll();
            }
        });

        renderAll();

        // ---- Save ----
        document.getElementById('saveBtn').addEventListener('click', async () => {
            const name = document.getElementById('tourName').value.trim();
            if (!name) { alert('Vui lòng nhập tên tour'); return; }
            if (stopsState.length === 0) { alert('Tour phải có ít nhất 1 stop'); return; }

            const payload = {
                name: name,
                description: document.getElementById('tourDescription').value.trim() || null,
                estimatedMinutes: parseInt(document.getElementById('tourEstimated').value) || null,
                isActive: document.getElementById('tourIsActive').checked,
                stops: stopsState.map((s, i) => ({ stallId: s.stallId, order: i + 1, note: s.note }))
            };

            const btn = document.getElementById('saveBtn');
            btn.disabled = true;
            try {
                const url = TOUR_ID ? `@Url.Action("Save", "Tour")?id=${TOUR_ID}` : '@Url.Action("Save", "Tour")';
                const res = await fetch(url, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(payload)
                });
                if (!res.ok) {
                    const err = await res.json().catch(() => ({}));
                    alert(err.message || 'Lưu thất bại');
                    return;
                }
                window.location.href = '@Url.Action("Index", "Tour")';
            } catch (e) {
                alert('Lỗi mạng: ' + e.message);
            } finally {
                btn.disabled = false;
            }
        });
    </script>
}
